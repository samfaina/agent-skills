{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*gh pr merge*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge-hook.sh\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(*gh pr merge*)",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/merge-hook.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
